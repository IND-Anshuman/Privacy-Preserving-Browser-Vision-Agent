# Extension build output. `extension/out-*/` is the escape hatch wxt.config.ts
# exposes via VEIL_OUT_DIR, used when .output is locked on Windows — so the
# pattern is a glob, not a fixed list, or a new build dir gets committed.
extension/out-*/
extension/.output/
