{
  "name": "veil-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Veil — privacy-preserving browser vision agent (WXT, Chrome MV3 + Firefox MV3)",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:all": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:python": "python ../bench/run_metrics.py"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@vitest/coverage-v8": "^2.1.8",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wxt": "^0.19.13"
  }
}
