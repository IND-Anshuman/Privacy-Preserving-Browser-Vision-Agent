# ─────────────────────────────────────────────────────────────────────────────
# Veil server configuration. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored. The server never logs the key, never returns it, and
# never puts it in an image layer. Nothing here is committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Which planner to use ─────────────────────────────────────────────────────
# auto    (default) prefer the local vLLM when it is up, else the API endpoint
# local  force vLLM — nothing leaves your machine
# openai force the API endpoint
VEIL_LLM_PROVIDER=auto

# ── The API endpoint ─────────────────────────────────────────────────────────
# Any OpenAI-compatible vision endpoint. Examples:
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   Together    https://api.together.xyz/v1
#   Ollama      http://127.0.0.1:11434/v1      (no key needed)
#   LM Studio   http://127.0.0.1:1234/v1       (no key needed)
#   vLLM        http://vllm:8001               (no key needed)
#
# Include the /v1 suffix. The server will tell you if it is missing (404).
VEIL_LLM_BASE_URL=

# Leave EMPTY for a local endpoint. A local server should not need a fake key,
# and putting a placeholder secret here is the habit this project avoids.
VEIL_LLM_API_KEY=

# MUST be vision-capable. There is no way to verify this from the server, so it
# is your responsibility — run bench/measure_grounding.py to check the model can
# actually target elements by [MARK] number before trusting it.
VEIL_LLM_MODEL=

# ── Output format ────────────────────────────────────────────────────────────
# strict  response_format json_schema with strict:true — the model CANNOT emit
#         an invalid plan. Best. Some OpenAI-compatible servers reject the
#         strict key; if you get a 400 mentioning `strict`, use `json`.
# json    response_format json_object — honoured well, not guaranteed. This
#         DOWNGRADES the declared guarantee and the client is told.
# text    no format at all. The validator is your only gate.
VEIL_LLM_MODE=strict

# ── Honest declarations ──────────────────────────────────────────────────────
# Only YOU know whether your tier excludes training from your content. Some free
# tiers explicitly do not. The server never infers this.
VEIL_LLM_ZDR=false

# Largest image the endpoint accepts, in bytes. 0 = no limit declared.
# Set this if your provider rejects large screenshots; the server will then
# refuse an oversized image with a clear error instead of a 400 from upstream.
VEIL_LLM_MAX_IMAGE_BYTES=0

# ── Cost accounting ──────────────────────────────────────────────────────────
# USD per 1,000,000 tokens. Leave unset and the server reports cost as UNKNOWN,
# which is honest. It never reports 0.0 for an unpriced provider.
# Checked 2026-09-28 against vendor pricing pages:
#   OpenAI GPT-6 Luna   0.10 in / 0.50 out
#   OpenAI GPT-6 Sol    2.00 in / 10.00 out
#   OpenAI GPT-6 Astra 10.00 in / 50.00 out
#   Gemini 3.8 Flash    0.75 in / 1.50 out   (free tier may train on content)
VEIL_LLM_PRICING_IN=
VEIL_LLM_PRICING_OUT=

# ── Behaviour ────────────────────────────────────────────────────────────────
# A plan below this confidence is replaced with ask_user. Lower = more cautious.
VEIL_CONFIDENCE_FLOOR=0.55

# Output ceiling, in tokens. A CEILING, not a reservation — you are billed only
# for tokens the model actually generates, so a high cap costs nothing unless it
# is used. 8192 clears any plan the 12-step schema allows.
#
# Do not lower this to "save money". The default used to be 512, which was not a
# cost control but a leftover, and it truncated plans mid-JSON. A truncated plan
# reaches the client as an UNPARSEABLE one, not a short one, and it fails closed.
VEIL_LLM_MAX_TOKENS=8192

# How much the manifest reveals about HOW MANY items of each class were hidden.
#   exact    counts as they are (default — maximum model usefulness)
#   bucketed power-of-two buckets: 1, 2-3, 4-7. Coarsening, not formal DP.
#   noise    Laplace noise on counts. The real DP mechanism, weakest for
#            utility at small counts.
VEIL_MANIFEST_PRIVACY=exact
VEIL_MANIFEST_EPSILON=1.0

# ── CORS ─────────────────────────────────────────────────────────────────────
# Your unpacked extension's id, from chrome://extensions. Looks like
# chrome-extension://<32 chars>. `dev` allows any extension origin and still
# refuses every http/https page.
VEIL_ALLOWED_ORIGINS=dev
